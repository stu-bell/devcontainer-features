  "id": "ttyd",
  "version": "0.1.0",
  "name": "ttyd",
  "description": "Installs ttyd - Share your terminal over the web. https://tsl0922.github.io/ttyd The ttyd options (port, cols, fontSize, readOnly) control the auto-generated .devcontainer/ttyd.sh script, but are ignored if a .devcontainer/ttyd.sh file already exists.",
  "keywords": ["terminal", "web terminal", "alpine", "ubuntu", "debian"],
  "documentationURL": "https://github.com/stu-bell/devcontainer-features/tree/main/src/ttyd",
  "licenseURL": "https://github.com/stu-bell/devcontainer-features/blob/main/LICENSE",
  "options": {
    "version": {
      "type": "string",
      "default": "latest",
      "description": "Version of ttyd to install (e.g., '1.7.4' or 'latest')"
    },
    "port": {
      "type": "string",
      "default": "7681",
      "description": "Port to run ttyd on."
    },
    "cols": {
      "type": "string",
      "default": "80",
      "description": "Number of columns for the terminal."
    },
    "fontSize": {
      "type": "string",
      "default": "20",
      "description": "Font size for the terminal."
    },
    "readOnly": {
      "type": "boolean",
      "default": false,
      "description": "If true, ttyd will be read-only (removes -W flag)."
    }

  },
  "installsAfter": [
    "ghcr.io/devcontainers/features/common-utils"
  ]
}
