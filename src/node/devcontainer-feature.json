  "id": "node",
  "version": "0.4.0",
  "name": "Node.js",
  "description": "Installs Node.js. If a qualifying version is not found, it installs a version of Node.js matching the provided target version, using nvm. For distros other than Alpine/Debian, it will install Node using the official devcontainer feature.",
  "keywords": ["node", "Node.js", "javascript", "typescript"],
  "documentationURL": "https://github.com/stu-bell/devcontainer-features/tree/main/src/node",
  "licenseURL": "https://github.com/stu-bell/devcontainer-features/blob/main/LICENSE",
  "options": {
    "node_target_version": {
      "type": "string",
      "default": "22",
      "description": "Target version of Node.js to install."
    }
  }
}
