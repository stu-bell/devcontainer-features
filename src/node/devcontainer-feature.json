  "id": "node",
  "version": "0.1.2",
  "name": "Node.js",
  "description": "Installs Node.js, if the minimum requested major version is not already installed.",
  "keywords": ["node", "Node.js", "javascript", "typescript"],
  "documentationURL": "https://github.com/stu-bell/devcontainer-features/tree/main/src/node",
  "licenceURL": "https://github.com/stu-bell/devcontainer-features/blob/main/LICENSE",
  "options": {
    "node_min_major_version": {
      "type": "string",
      "default": "22",
      "description": "Minimum major version of Node.js required."
    }
  },
  "containerEnv": {
    "PATH": "/usr/bin:$PATH"
  }
}
