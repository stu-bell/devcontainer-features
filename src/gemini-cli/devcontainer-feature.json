  "id": "gemini-cli",
  "version": "0.1.6",
  "name": "Google Gemini CLI (via npm)",
  "description": "Installs Google Gemini CLI for AI code assistance https://geminicli.com",
  "keywords": ["AI", "agent", "code", "coding", "alpine", "ubuntu", "debian"],
  "documentationURL": "https://github.com/stu-bell/devcontainer-features/tree/main/src/gemini-cli",
  "licenseURL": "https://github.com/stu-bell/devcontainer-features/blob/main/LICENSE",
  "options": {
    "gemini_version": {
      "default": "latest",
      "description": "Version of Gemini CLI to install https://www.npmjs.com/package/@google/gemini-cli#release-cadence-and-tags",
      "type": "string",
      "proposals":[
        "latest",
        "nightly",
        "preview"
      ]
    },
    "min_node_version": {
      "default": "20",
      "description": "Minimum version of Node required to install Gemini CLI",
      "type": "string"
    }
  },
  "dependsOn": {
    "ghcr.io/stu-bell/devcontainer-features/node": {
      "min_node_version": "20",
      "installYarnUsingApt": false,
      "nodeGypDependencies": false
    }
  }
}

